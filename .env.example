# Copia questo file in .env e compila i valori (install.sh genera le password in automatico).

# Dominio pubblico (deve puntare all'IP della VPS) ed email per il certificato HTTPS
SITE_DOMAIN=blubeauty.blucodeinformatica.it
ACME_EMAIL=alessandrofierro50@gmail.com

# Server con un nginx già attivo sulle porte 80/443 (lo imposta install.sh): Caddy in http su una porta locale
# CADDY_SITE=:80
# HTTP_BIND=127.0.0.1:8090
# HTTPS_BIND=127.0.0.1:8453

# Server con poca memoria (meno di 3 GB): un processo per l'API e uno per i lavori in background
# API_WORKERS=1
# CELERY_CONCURRENCY=1

# Password del database
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Chiave segreta per le sessioni (stringa lunga e casuale)
SECRET_KEY=

# Super amministratore iniziale (cambia la password al primo accesso e attiva la verifica in due passaggi)
SUPERADMIN_EMAIL=alessandrofierro50@gmail.com
SUPERADMIN_PASSWORD=

# Email in uscita (credenziali, avvisi di scadenza, inviti): SMTP Aruba, porta 465 con SSL.
# Utente = indirizzo completo. La password va scritta solo nel .env del server, mai nel repository.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@blucodeinformatica.it
SMTP_PASSWORD=
SMTP_TLS=true
# Mittente di tutte le email ai clienti (le risposte arrivano allo stesso indirizzo)
SMTP_FROM=info@blucodeinformatica.it
MAIL_FROM_NAME=BluBeauty · BluCode Informatica
# Comunicazioni a BluCode: nuove prove, copia degli avvisi di scadenza, riepilogo settimanale del lunedì
ADMIN_NOTIFY_EMAIL=blubeauty@blucodeinformatica.it
# Contatti per rinnovare, mostrati nella pagina «Abbonamento» e negli avvisi ({contatti})
SUPPORT_EMAIL=info@blucodeinformatica.it
SUPPORT_PHONE=379 233 3492

# BluCode Console (standard comune abbonamenti §7-§8)
# Riepilogo GET /api/console/riepilogo con «Authorization: Bearer <CONSOLE_API_KEY>». Vuota = endpoint disattivato (404).
# Generala lunga e casuale, es.: openssl rand -hex 32
CONSOLE_API_KEY=
# Seconda chiave (diversa dalla prima) per POST /api/console/super-admin/credenziali, header X-Console-Admin-Key.
# Vuota = cambio credenziali dalla Console disattivato (404).
CONSOLE_ADMIN_KEY=
# Super amministratore da cambiare se ce n'è più d'uno (vuoto = il primo creato)
CONSOLE_SUPERADMIN_EMAIL=

# Fatturazione elettronica Aruba (modulo extra). Ambiente: demo oppure produzione.
# Utenza Premium della piattaforma: le aziende clienti vanno aggiunte come cedenti (multicedenti) nel pannello Aruba.
# In alternativa ogni azienda può inserire le proprie credenziali Aruba da BluBeauty (Impostazioni › Fatturazione elettronica).
ARUBA_ENV=demo
ARUBA_USERNAME=
ARUBA_PASSWORD=
# Chiave scelta nel pannello Aruba per le callback; URL da indicare: https://SITE_DOMAIN/api/fatturapa/callback/<metodo>
ARUBA_CALLBACK_KEY=

# Pagamenti online degli abbonamenti (contratto comune pagamenti.md; guida: docs/PAGAMENTI.md).
# Un metodo compare solo se è elencato qui E ha le sue chiavi. Il bonifico funziona subito con l'IBAN.
PAGAMENTI_METODI=carta,paypal,bonifico
# Stripe (carta, Google Pay, Apple Pay): chiave segreta sk_test_/sk_live_ e segreto del webhook whsec_
# Webhook da creare in Stripe: https://SITE_DOMAIN/api/pagamenti/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (REST app del conto Business). Webhook: https://SITE_DOMAIN/api/pagamenti/webhook/paypal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# Bonifico: intestatario e IBAN mostrati al cliente (modificabili anche da Impostazioni › Pagamenti)
BONIFICO_INTESTATARIO=BluCode Informatica
BONIFICO_IBAN=
# Cedente delle fatture degli abbonamenti (BluCode)
CEDENTE_DENOMINAZIONE=BluCode Informatica
CEDENTE_PIVA=05357210755
CEDENTE_CF=
CEDENTE_INDIRIZZO=Via Napoli 78
CEDENTE_CAP=73036
CEDENTE_COMUNE=Muro Leccese
CEDENTE_PROVINCIA=LE
# Regime forfettario: righe a 0% con Natura N2.2. Bollo virtuale 2 € oltre 77,47 €: cliente | cedente
REGIME_FISCALE=RF19
BOLLO_A_CARICO=cliente
# Numerazione N/BB per anno solare. Invio: manuale (XML per email a ADMIN_NOTIFY_EMAIL) | sdi (tramite Aruba, ARUBA_*)
FATTURE_SEZIONALE=BB
FATTURE_INVIO=manuale

# Prova gratuita dal sito: pacchetto (vuoto = iscrizioni chiuse), giorni e moduli extra inclusi
TRIAL_PLAN=SALONE
TRIAL_DAYS=7
TRIAL_EXTRA_MODULES=
WEBSITE_URL=https://blucodeinformatica.it
# Termini di utilizzo: la versione deve coincidere con quella del sito; il PDF si scarica e si allega all'email delle credenziali
TERMS_VERSION=1.0
TERMS_URL=https://blucodeinformatica.it/termini/
TERMS_PDF_URL=https://blucodeinformatica.it/termini/termini-di-utilizzo-v1.0.pdf

# Crea le tre aziende di esempio (abbigliamento, panetteria, ferramenta). Lascia vuoto in produzione.
SEED_DEMO=1

# Backup fuori dalla VPS (facoltativo): nome di un remote rclone già configurato, es. "s3backup:blubeauty"
BACKUP_REMOTE=
