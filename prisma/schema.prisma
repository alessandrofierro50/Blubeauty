// BluBeauty — schema dati
// Architettura multi-tenant: ogni record di business appartiene a un'Organizzazione
// (il salone / centro estetico cliente di BluBeauty). Un'organizzazione può avere più sedi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Tenant, sedi, utenti
// ─────────────────────────────────────────────────────────────

enum BusinessType {
  HAIR // parrucchiere / barber
  BEAUTY // centro estetico / spa
  MIXED // entrambi
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique // usato per la pagina di prenotazione pubblica
  businessType BusinessType @default(MIXED)
  vatNumber    String? // partita IVA
  fiscalCode   String?
  email        String?
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  locations         Location[]
  memberships       Membership[]
  staff             StaffMember[]
  clients           Client[]
  serviceCategories ServiceCategory[]
  services          Service[]
  resources         Resource[]
  appointments      Appointment[]
  products          Product[]
  packageTemplates  PackageTemplate[]
  clientPackages    ClientPackage[]
  sales             Sale[]
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  city           String?
  phone          String?
  timezone       String       @default("Europe/Rome")
  // Orari di apertura: { "mon": [["09:00","13:00"],["15:00","19:30"]], ... }
  openingHours   Json?
  createdAt      DateTime     @default(now())

  resources    Resource[]
  appointments Appointment[]
  staff        StaffMember[]
  sales        Sale[]

  @@index([organizationId])
}

enum Role {
  OWNER // titolare: accesso completo
  MANAGER // responsabile di sede
  RECEPTION // agenda, clienti, cassa
  OPERATOR // vede la propria agenda e le schede clienti
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  staff       StaffMember?
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(RECEPTION)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

// ─────────────────────────────────────────────────────────────
// Personale e risorse (cabine, postazioni, macchinari)
// ─────────────────────────────────────────────────────────────

model StaffMember {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId           String?
  location             Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId               String?      @unique // se l'operatore ha accesso al gestionale
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName            String
  lastName             String
  color                String       @default("#2563eb") // colore in agenda
  active               Boolean      @default(true)
  // Provvigioni di default in percentuale (0-100)
  serviceCommissionPct Decimal      @default(0) @db.Decimal(5, 2)
  productCommissionPct Decimal      @default(0) @db.Decimal(5, 2)
  createdAt            DateTime     @default(now())

  appointmentItems AppointmentItem[]
  services         StaffService[]
  saleLines        SaleLine[]

  @@index([organizationId])
}

enum ResourceType {
  CABIN // cabina estetica
  STATION // postazione / poltrona
  WASH // lavatesta
  MACHINE // macchinario (laser, pressoterapia...)
}

model Resource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  type           ResourceType
  active         Boolean      @default(true)

  appointmentItems AppointmentItem[]
  services         Service[]         @relation("ServiceRequiredResources")

  @@index([organizationId, locationId])
}

// ─────────────────────────────────────────────────────────────
// Catalogo servizi
// ─────────────────────────────────────────────────────────────

model ServiceCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)

  services Service[]

  @@index([organizationId])
}

model Service {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  price              Decimal          @db.Decimal(10, 2)
  vatRate            Decimal          @default(22) @db.Decimal(5, 2)
  // Durata in minuti suddivisa in fasi: lavoro operatore → posa (operatore libero) → finitura.
  // Esempio colore: 20 min applicazione, 35 min posa, 25 min lavaggio+piega.
  durationMin        Int // durata totale
  processingStartMin Int? // inizio del tempo di posa (minuti dall'inizio)
  processingMin      Int? // durata del tempo di posa
  bookableOnline     Boolean          @default(true)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())

  requiredResources Resource[]        @relation("ServiceRequiredResources")
  staff             StaffService[]
  appointmentItems  AppointmentItem[]
  packageTemplates  PackageTemplate[]

  @@index([organizationId])
}

// Quali operatori eseguono quali servizi (con eventuale durata/prezzo personalizzati)
model StaffService {
  staffId     String
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  durationMin Int?
  price       Decimal?    @db.Decimal(10, 2)

  @@id([staffId, serviceId])
}

// ─────────────────────────────────────────────────────────────
// Clienti (CRM) e schede tecniche
// ─────────────────────────────────────────────────────────────

model Client {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  phone              String?
  email              String?
  birthDate          DateTime?    @db.Date
  gender             String?
  fiscalCode         String?
  notes              String?
  // Consensi GDPR
  privacyConsentAt   DateTime?
  marketingConsentAt DateTime?
  // Fidelity
  loyaltyPoints      Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  appointments   Appointment[]
  technicalCards TechnicalCard[]
  packages       ClientPackage[]
  sales          Sale[]

  @@index([organizationId, lastName])
  @@index([organizationId, phone])
}

enum TechnicalCardType {
  COLOR // formula colore (parrucchiere)
  TREATMENT // trattamento estetico
  ANAMNESIS // anamnesi / controindicazioni
  CONSENT // consenso informato firmato
}

model TechnicalCard {
  id        String            @id @default(cuid())
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      TechnicalCardType
  title     String
  // Contenuto strutturato libero, es. { brand, shade, developer, minutes } o parametri macchinario
  data      Json
  notes     String?
  signedAt  DateTime? // per i consensi firmati
  createdAt DateTime          @default(now())

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Agenda
// ─────────────────────────────────────────────────────────────

enum AppointmentStatus {
  BOOKED // prenotato
  CONFIRMED // confermato dal cliente
  ARRIVED // in salone
  COMPLETED // concluso
  PAID // incassato
  CANCELLED // disdetto
  NO_SHOW // non presentato
}

enum BookingChannel {
  STAFF // inserito dal salone
  ONLINE // prenotazione online
  PHONE
  WHATSAPP
  AI // receptionist AI (futuro)
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(BOOKED)
  channel        BookingChannel    @default(STAFF)
  notes          String?
  depositAmount  Decimal?          @db.Decimal(10, 2) // caparra anti no-show
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items AppointmentItem[]
  sale  Sale?

  @@index([organizationId, locationId, startsAt])
}

// Un appuntamento può contenere più servizi, anche con operatori diversi
model AppointmentItem {
  id              String         @id @default(cuid())
  appointmentId   String
  appointment     Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id])
  staffId         String?
  staff           StaffMember?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  resourceId      String?
  resource        Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  endsAt          DateTime
  price           Decimal        @db.Decimal(10, 2)
  clientPackageId String? // se la seduta viene scalata da un pacchetto
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)

  @@index([staffId, startsAt])
  @@index([resourceId, startsAt])
}

// ─────────────────────────────────────────────────────────────
// Pacchetti a sedute, gift card
// ─────────────────────────────────────────────────────────────

model PackageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name           String // es. "10 sedute pressoterapia"
  sessions       Int
  price          Decimal      @db.Decimal(10, 2)
  validityDays   Int?
  active         Boolean      @default(true)

  clientPackages ClientPackage[]

  @@index([organizationId])
}

model ClientPackage {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageTemplateId String
  packageTemplate   PackageTemplate @relation(fields: [packageTemplateId], references: [id])
  sessionsTotal     Int
  sessionsUsed      Int             @default(0)
  purchasedAt       DateTime        @default(now())
  expiresAt         DateTime?

  appointmentItems AppointmentItem[]

  @@index([organizationId, clientId])
}

// ─────────────────────────────────────────────────────────────
// Magazzino
// ─────────────────────────────────────────────────────────────

enum ProductUsage {
  RETAIL // rivendita al cliente
  INTERNAL // uso interno (es. colore, cere)
  BOTH
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  brand          String?
  barcode        String?
  usage          ProductUsage @default(RETAIL)
  price          Decimal?     @db.Decimal(10, 2) // prezzo di vendita
  cost           Decimal?     @db.Decimal(10, 2) // costo d'acquisto
  vatRate        Decimal      @default(22) @db.Decimal(5, 2)
  stock          Decimal      @default(0) @db.Decimal(10, 2)
  minStock       Decimal?     @db.Decimal(10, 2)
  unit           String       @default("pz") // pz, ml, g
  active         Boolean      @default(true)

  saleLines SaleLine[]

  @@index([organizationId])
  @@index([organizationId, barcode])
}

// ─────────────────────────────────────────────────────────────
// Cassa
// ─────────────────────────────────────────────────────────────

enum SaleStatus {
  OPEN
  PAID
  REFUNDED
  VOID
}

enum FiscalDocType {
  NONE
  RECEIPT // documento commerciale tramite RT
  INVOICE // fattura elettronica (SDI)
}

model Sale {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  status         SaleStatus    @default(OPEN)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  fiscalDocType  FiscalDocType @default(NONE)
  fiscalDocRef   String? // numero documento commerciale / fattura
  createdAt      DateTime      @default(now())
  closedAt       DateTime?

  lines    SaleLine[]
  payments Payment[]

  @@index([organizationId, createdAt])
}

enum SaleLineKind {
  SERVICE
  PRODUCT
  PACKAGE
  GIFT_CARD
}

model SaleLine {
  id          String       @id @default(cuid())
  saleId      String
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind        SaleLineKind
  description String
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  staffId     String? // per il calcolo provvigioni
  staff       StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(10, 2)
  vatRate     Decimal      @db.Decimal(5, 2)
}

enum PaymentMethod {
  CASH
  CARD
  SATISPAY
  BANK_TRANSFER
  GIFT_CARD
  PACKAGE
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
}
